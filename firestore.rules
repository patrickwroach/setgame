rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    
    // Invite codes - anyone can read hash for validation, only admins can write
    match /invite_codes/{docId} {
      allow read: if true; // Can read hash publicly, actual code protected by client logic
      allow write: if isAdmin();
    }
    
    // Sign-up attempts tracking (for rate limiting)
    match /signup_attempts/{attemptId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.date == resource.data.date;
      allow delete: if false;
    }
    
    // Daily completions
    match /daily_completions/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection (keyed by UID)
    // Users can update their own document but cannot change admin or approved fields
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.admin == resource.data.admin &&
                      request.resource.data.approved == resource.data.approved;
      allow delete: if false;
    }
    
    // User profiles (optional - for display names, etc.)
    match /user_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Daily comments — parent date document + comments subcollection
    match /daily_comments/{date} {
      allow read: if request.auth != null;
      allow write: if false; // Date docs are auto-created by subcollection writes

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                        request.resource.data.userId == request.auth.uid;
        // Only allow reaction changes — all other fields must stay the same
        allow update: if request.auth != null &&
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.displayName == resource.data.displayName &&
                        request.resource.data.text == resource.data.text &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.parentId == resource.data.parentId;
        allow delete: if request.auth != null && 
                        (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Announcements — readable by any authenticated user, admin-only writes
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Announcement dismissals — each user manages their own
    match /announcement_dismissals/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
